# DEPRECATED: This service will be removed in a future release.
# Job-posting functionality is being merged into the full node.
[Unit]
Description=GeniusSDK Job Poster Node
After=network.target

[Service]
Type=simple
User=geniussdk
# DEPRECATED: Use genius-full-node.service with GENIUS_PROCESS=1 instead
ExecStart=/usr/bin/GeniusSDKService /var/lib/geniussdk/jobposter 1 1 40002 0
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

# DEPRECATED
[Install]
WantedBy=multi-user.target
