[Unit]
Description=GeniusSDK Archive Node
After=network.target

[Service]
Type=simple
User=geniussdk
EnvironmentFile=-/etc/geniussdk/common.conf
Environment="GENIUSSDK_BIN=/usr/bin/GeniusSDKService"
Environment="GENIUSSDK_ARCHIVE_PATH=/var/lib/geniussdk/archive"
ExecStart=/bin/sh -c 'exec $GENIUSSDK_BIN $GENIUSSDK_ARCHIVE_PATH 1 0 40001 1'
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
